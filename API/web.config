<?xml version="1.0" encoding="utf-8"?>
<!-- Publish adds the ASP.NET Core module (handlers, aspNetCore) to this file; the settings below are kept.
     Security scan (Qualys, 13 Oct 2026), applied to the API as to the CMS:
       - removeServerHeader: hide the "Server: Microsoft-IIS/10.0" banner (QID 86000 / 45104)
       - TRACE / TRACK refused (QID 45056)
       - X-Content-Type-Options and Referrer-Policy on every response (QID 11827 / 48131) -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering removeServerHeader="true">
          <verbs>
            <add verb="TRACE" allowed="false" />
            <add verb="TRACK" allowed="false" />
          </verbs>
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        </customHeaders>
      </httpProtocol>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\BlazorDev.WebAPI.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
<!--ProjectGuid: 09879F91-483D-E9AB-593C-C98769818C33-->